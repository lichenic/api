{
    "name": "lichenic-api",
    "version": "0.1.0",
    "description": "The backend for lichenic, a new social media app",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/server.js",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.18.0",
            "onFail": "download"
        }
    },
    "packageManager": "pnpm@12.18.0",
    "type": "module",
    "dependencies": {
        "@hono/node-server": "^2.1.6",
        "argon2": "^0.45.2",
        "dotenv": "^18.0.10",
        "drizzle-orm": "^0.45.4",
        "hono": "^4.13.17",
        "pg": "^8.23.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/pg": "^8.23.1",
        "drizzle-kit": "^0.31.11",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "imports": {
        "#api/*": "./src/*",
        "#db": "./src/db/index.js",
        "#db/*": "./src/db/*"
    }
}
